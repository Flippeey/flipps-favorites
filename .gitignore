# Ignore build artifacts, dependencies, and generated files
dist/
node_modules/
releases/
docs/*

# Claude Code (config, agents, runtime data)
# Root CLAUDE.md is tracked (shared project instructions); .claude/ detail docs stay local.
.claude/
.mcp.json

# Runtime / generated data
.swarm/

# Visual inspection screenshots (local reference only)
screenshots/
promo-videos/
/promo/

# Playwright
tests/.firefox-profile/
test-results/
playwright-report/

# Ignore GitHub metadata, but keep CI workflows tracked
.github/*
!.github/workflows/

# Ignore editor settings
.vscode
# Firefox E2E spike (throwaway, has own node_modules)
tests/spike-firefox-puppeteer/
# Playwright test artifacts
tests/.artifacts/
