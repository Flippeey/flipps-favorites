# Ignore build artifacts, dependencies, and generated files
dist/
node_modules/
releases/
docs/*

# gem-team agent config — personal process tooling, canonical copy lives in claude-setup
.gem-team.yaml

# Claude Code (config, agents, runtime data)
# Ignore .claude/ contents by default; selectively track shared docs + safe settings.
# NOTE: must be `.claude/*` (not `.claude/`) — a dir/ ignore can't be undone by `!` negation.
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/structure.md
!.claude/architecture.md
!.claude/conventions.md
!.claude/testing.md
# Explicitly keep ignored (defense-in-depth; already covered by .claude/* since these are top-level):
.claude/settings.local.json
.mcp.json

# Runtime / generated data
.swarm/

# Visual inspection screenshots (local reference only)
screenshots/
promo-videos/
/promo/

# Playwright
tests/.firefox-profile/
test-results/
playwright-report/

# Ignore GitHub metadata, but keep CI workflows + Dependabot config tracked
.github/*
!.github/workflows/
!.github/dependabot.yml

# Ignore editor settings
.vscode
# Firefox E2E spike (throwaway, has own node_modules)
tests/spike-firefox-puppeteer/
# Playwright test artifacts
tests/.artifacts/

# Evidence spec screenshots (generated per-run, uploaded to pr-evidence branch by CI)
tests/evidence/output/
