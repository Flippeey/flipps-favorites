{
  "name": "flipps-favorites-bookmarks-and-more",
  "version": "2.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome --outDir dist/chrome && node scripts/write-manifest.mjs chrome dist/chrome",
    "build:firefox": "vite build --mode firefox --outDir dist/firefox && node scripts/write-manifest.mjs firefox dist/firefox",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:firefox": "playwright test --project=firefox",
    "test:chrome": "playwright test --project=chrome",
    "test:ui": "playwright test --ui",
    "test:group": "playwright test --project=chrome -g",
    "test:report": "playwright test --project=chrome --reporter=html",
    "test:headed": "playwright test --project=chrome --headed",
    "test:ci": "npm run build && playwright test --reporter=github,html",
    "test:build": "npm run build && npm test",
    "promo": "node scripts/promo/index.mjs all",
    "promo:screenshots": "node scripts/promo/index.mjs screenshots",
    "promo:videos": "node scripts/promo/index.mjs videos",
    "promo:gif": "node scripts/promo/to-gif.mjs",
    "promo:mp4": "node scripts/promo/to-mp4.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.1.42",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
